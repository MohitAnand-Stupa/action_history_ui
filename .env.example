# Action History viewer -- which databases it may read.
#
# ENVIRONMENTS and SERVICES are what the dropdowns offer, in order, as key:Label.
# Each <ENVIRONMENT>_<SERVICE>_TENANT_CONFIGS is that service's own TENANT_CONFIGS
# JSON, copied from its .env for that environment. Leave one empty and the viewer
# says the environment/service isn't configured.
#
# The viewer only ever reads: every connection is opened read-only.
# USER_ROLE_SERVICE is used to show names and roles instead of user ids.
#
# Copy to .env and fill in. .env holds passwords; never commit it.

ENVIRONMENTS=development:Development,staging:Staging,preprod:Preprod,production:Production
SERVICES=tms:TMS,user_role_service:User Role Service,ctms:CTMS,rnr:RNR (Ranking & Rating),order:Order

# --- Development ----------------------------------------
DEVELOPMENT_TMS_TENANT_CONFIGS={"dev":{"DB_USER":"","DB_PASS":"","DB_HOST":"","DB_PORT":"5432","DB_NAME":"tms","DB_SCHEMA":"dev"}}
DEVELOPMENT_USER_ROLE_SERVICE_TENANT_CONFIGS=
DEVELOPMENT_CTMS_TENANT_CONFIGS=
DEVELOPMENT_RNR_TENANT_CONFIGS=
DEVELOPMENT_ORDER_TENANT_CONFIGS=

# --- Staging ----------------------------------------
STAGING_TMS_TENANT_CONFIGS=
STAGING_USER_ROLE_SERVICE_TENANT_CONFIGS=
STAGING_CTMS_TENANT_CONFIGS=
STAGING_RNR_TENANT_CONFIGS=
STAGING_ORDER_TENANT_CONFIGS=

# --- Preprod ----------------------------------------
PREPROD_TMS_TENANT_CONFIGS=
PREPROD_USER_ROLE_SERVICE_TENANT_CONFIGS=
PREPROD_CTMS_TENANT_CONFIGS=
PREPROD_RNR_TENANT_CONFIGS=
PREPROD_ORDER_TENANT_CONFIGS=

# --- Production ----------------------------------------
PRODUCTION_TMS_TENANT_CONFIGS=
PRODUCTION_USER_ROLE_SERVICE_TENANT_CONFIGS=
PRODUCTION_CTMS_TENANT_CONFIGS=
PRODUCTION_RNR_TENANT_CONFIGS=
PRODUCTION_ORDER_TENANT_CONFIGS=
