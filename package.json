{
  "name": "action-history-ui",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,react --prefix-colors magenta,cyan \"python3 serve.py\" \"vite\"",
    "dev:ui": "vite",
